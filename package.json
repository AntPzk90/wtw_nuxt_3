  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "json-server": "^1.0.0-beta.15",
    "lowdb": "^7.0.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
